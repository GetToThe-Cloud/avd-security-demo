// Successful AVD sign-in from a country this user has not used before       chain step 2
// Template from Part III. Your users connect from a predictable set of places, so this is
// a high-quality signal. Tune Lookback and Recent to your environment.
// Includes non-interactive sign-ins: a stolen token replayed from somewhere new is silent
// and only shows up in AADNonInteractiveUserSignInLogs.
let Lookback = 30d;
let Recent = 1d;
let AvdIds = dynamic(["9cdead84-a844-4324-93f2-b2e6bb768d07", "270efc09-cd0d-444b-a71f-39af4910ec45"]);
let AvdSignIns = union isfuzzy=true
        (SigninLogs | extend Location = tostring(LocationDetails)),
        (AADNonInteractiveUserSignInLogs | extend Location = tostring(LocationDetails))
    | where TimeGenerated > ago(Lookback)
    | where ResultType == "0" and (AppId in (AvdIds) or ResourceIdentity in (AvdIds))
    | extend Country = tostring(parse_json(Location).countryOrRegion);
let Known = AvdSignIns
    | where TimeGenerated <= ago(Recent)
    | distinct UserPrincipalName, Country;
AvdSignIns
| where TimeGenerated > ago(Recent)
| join kind=leftanti Known on UserPrincipalName, Country
| summarize FirstSeen = min(TimeGenerated), SignIns = count(), IPAddresses = make_set(IPAddress, 10),
            Apps = make_set(AppDisplayName, 10), Resources = make_set(ResourceDisplayName, 10)
          by UserPrincipalName, Country
| order by FirstSeen desc
