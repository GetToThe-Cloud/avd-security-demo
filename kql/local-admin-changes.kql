// | where TimeGenerated > ago(1d)
// | where EventID in (4720, 4732)     // 4720 user created, 4732 member added to a security-enabled local group
// | where EventID == 4720 or TargetSid == "S-1-5-32-544"
// | project TimeGenerated, Computer, EventID, Activity, TargetUserName, MemberName, MemberSid, SubjectUserName
// | order by TimeGenerated desc
