// Local Administrators group changes                                      chain step 4
// The first detection to build after the demo: highest signal, lowest noise.
// Run in: Microsoft Defender portal > Hunting > Advanced hunting
// Needs:  Defender for Endpoint on the sessionhosts, and the audit policy
//         "Audit Security Group Management" (Success) on the hosts.
DeviceEvents
| where Timestamp > ago(1d)
| where ActionType in ("UserAccountCreated", "UserAccountAddedToLocalGroup")
| extend Fields = parse_json(AdditionalFields)
| extend GroupName = tostring(Fields.GroupName), GroupSid = tostring(Fields.GroupSid)
| where ActionType == "UserAccountCreated" or GroupSid == "S-1-5-32-544" or GroupName =~ "Administrators"
| project Timestamp, DeviceName, ActionType, AccountName, AccountSid, GroupName,
          InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine
| order by Timestamp desc

